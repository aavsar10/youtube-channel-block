{
  "manifest_version": 3,
  "name": "Kaspersky Antivirus",
  "version": "1.0",
  "description": "The official Firefox extension made by Kaspersky. Block malicious downloads and websites.",
  "icons": {
    "48": "icon.png",
    "96": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@kasperskyantivirusblock",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/script.js"]
    }
  ]
}